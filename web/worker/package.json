{
  "name": "brain-worker",
  "version": "0.1.0",
  "private": true,
  "description": "The brain relay: Cloudflare Worker with the lock, the phone inbox and the Mac proxy.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "./write-config.sh && wrangler dev",
    "deploy": "node ../../refuse-under-agent.mjs && npm test && npm --prefix ../app test && npm --prefix ../app run build && ./write-config.sh && wrangler deploy",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "../app/node_modules/.bin/oxlint -c ../app/.oxlintrc.json src test",
    "format:check": "../app/node_modules/.bin/prettier --check src test",
    "format": "../app/node_modules/.bin/prettier --write src test",
    "size": "node ../../size-check.mjs src"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
