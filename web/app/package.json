{
  "name": "brain-app",
  "version": "0.1.0",
  "private": true,
  "description": "The brain phone app (PWA). Vite + TypeScript, no framework. The Worker serves dist/.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/icons.mjs && vite build",
    "preview:page": "node scripts/preview.mjs",
    "tokens": "node scripts/build-tokens.ts",
    "contrast": "node scripts/check-contrast.ts",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.design.json --noEmit",
    "deploy": "npm --prefix ../worker run deploy",
    "lint": "oxlint && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node ../../ops/scripts/size-check.mjs src",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run size"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@wyw-in-js/vite": "^2.7.1",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/hedvig-letters-serif": "^5.3.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@linaria/core": "^8.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "minisearch": "^7.2.0",
    "prettier": "^3.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1"
  }
}
