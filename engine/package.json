{
  "name": "brain",
  "version": "0.1.0",
  "private": true,
  "description": "Query, check and report on the Markdown notes in a brain folder.",
  "type": "module",
  "bin": {
    "brain": "bin/brain.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "size": "node ../ops/scripts/size-check.mjs src bin",
    "check": "npm run typecheck && npm run size"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
