  {
    "name": "make_note",
    "description": "Make a note from a type and a title. Use for a new goal, decision or project.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "A note type, like Goal, Decision or Project."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "draft_id": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "description": "Any of why, when, date, with, decide_by, subjects, birthday, from, renews, status. Text, or a list of text.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Area slugs, like health."
        },
        "parent": {
          "type": "string",
          "description": "A goal path or slug. The new goal is its subgoal."
        },
        "sections": {
          "type": "object",
          "description": "Lines under headings, like { \"# Targets\": [\"- [ ] Run 5 km\"] }.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "relations": {
          "type": "array",
          "description": "Links written in the new note.",
          "items": {
            "type": "object",
            "properties": {
              "to": {
                "type": "string",
                "description": "A note path, like people/dana-cole.md."
              },
              "role": {
                "type": "string"
              },
              "time": {
                "type": "string"
              }
            },
            "required": [
              "to"
            ],
            "additionalProperties": false
          }
        },
        "todos": {
          "type": "array",
          "description": "To-dos under # To-dos. Text, or an object.",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "when": {
                    "type": "string",
                    "description": "today, tomorrow, someday, waiting, note, or a date like 2026-05-04."
                  },
                  "toward": {
                    "type": "string",
                    "description": "A goal path this to-do is toward."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "edit_note",
