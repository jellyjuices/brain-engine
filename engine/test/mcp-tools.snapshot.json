        },
        "happened": {
          "type": "string",
          "description": "What happened."
        },
        "follow_up": {
          "type": "string",
          "description": "The next to-do."
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
