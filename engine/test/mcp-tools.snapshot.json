[
  {
    "name": "add",
    "description": "Add a thought. A tag, person or subject files it at once; journal keeps it whole as a note. Use for any new thought or to-do.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string",
          "description": "Any unique id. A retry with the same id makes no copy."
        },
        "text": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "description": "ISO time."
        },
        "into": {
          "type": "string",
          "description": "A note path to file it in."
        },
        "about": {
          "description": "Note paths. With kind feeling, the side: what it is about, in the owner's words.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Note paths."
            },
            {
              "type": "string"
            }
          ]
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Person note paths."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "by": {
          "type": "string",
          "description": "Your name. It goes on the generated label."
        },
        "draft_id": {
          "type": "string"
        },
        "when": {
          "type": "string",
          "description": "today, tomorrow, someday, waiting, note, or a date like 2026-05-04."
        },
        "kind": {
          "type": "string",
          "enum": [
            "todo",
            "journal",
            "fact",
            "feeling"
          ],
          "description": "todo writes a to-do line. journal keeps the text whole as its own note, to sort later. fact and feeling write one dated line into into."
        },
        "title": {
          "type": "string",
          "description": "A journal note's title. With none, the first words."
        }
      },
      "required": [
        "client_id",
        "text"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "done",
    "description": "Tick a to-do, with an optional note and follow-up. A repeating one moves to its next date. Use when a to-do is finished.",
