  {
    "name": "sort",
    "description": "Sort a capture or journal note into subjects. A capture is deleted; a journal stays whole. Use on an item from unsorted.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "A path from unsorted: a capture in inbox/ or a journal note in journal/."
        },
        "into": {
          "type": "string",
          "description": "A note path, like people/dana-cole.md."
        },
        "when": {
          "type": "string",
          "description": "today, tomorrow, someday, waiting, note, or a date like 2026-05-04."
        },
        "bits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "into": {
                "type": "string",
                "description": "A note path, like people/dana-cole.md."
              },
              "when": {
                "type": "string",
                "description": "today, tomorrow, someday, waiting, note, or a date like 2026-05-04."
              },
              "text": {
                "type": "string"
              },
              "with": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Person note paths."
              },
              "re": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Note paths."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "to-do",
                  "fact",
                  "feeling",
                  "decision"
                ]
              },
              "about": {
                "type": "string",
                "description": "What it is about, in the owner's words. A feeling needs it."
              }
            },
            "required": [
              "into",
              "when"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "Instead of into and when, one entry per line."
        },
        "draft_id": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
