#!/bin/sh
cd "$(git rev-parse --show-toplevel)" || exit 1
code=0
while read -r _ local_sha _ _; do
  case "$local_sha" in *[!0]*) code=1 ;; esac
done
if [ "$code" = 0 ]; then
  echo "pre-push: no code to push. Gates skipped."
  exit 0
fi
log=$(mktemp)
echo "pre-push: running the gates..."
if npm run gates >"$log" 2>&1; then
  echo "pre-push: all gates passed."
  exit 0
fi
echo "pre-push: a gate failed. The push is stopped."
grep -n -E "^✖|^not ok|error TS|Error:|FAIL|✗| failed|size-check:|privacy-check:" "$log" | head -40
echo "Full output: $log"
exit 1
