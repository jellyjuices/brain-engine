# Copy to ~/.config/brain/env (or $BRAIN_CONFIG/env). setup.sh writes this file for you.
# Never commit the real file.

# Absolute path to the Node binary the background jobs use.
NODE=
# Absolute path to your brain folder (your notes).
BRAIN_HOME=
# Absolute path to this engine.
BRAIN_ENGINE=
# Optional: other names the server accepts as you, comma-separated.
BRAIN_OWNER_ALIASES=

# Optional overrides
# BRAIN_CONFIG=        # folder for these config files (default ~/.config/brain)
# BRAIN_TOKEN_FILE=    # server token file (default ~/.config/brain/token)
# BRAIN_AGENT_TOKEN_FILE=  # helpers' token file (default ~/.config/brain/agent-token), see agent-token.example
# BRAIN_RELAY_ENV=     # relay settings file (default ~/.config/brain/relay.env)
# BRAIN_APP_DIR=       # built web app folder (default app/dist)
# BRAIN_WEB_URL=       # address the menu bar app opens (default the local server)
