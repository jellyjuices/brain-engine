<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. setup.sh fills in the __WORDS__ and installs it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.brain.pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>__ENGINE__/engine/bin/brain.ts</string>
    <string>pull</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BRAIN_HOME</key><string>__BRAIN_HOME__</string>
    <key>PATH</key><string>__NODE_DIR__:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOGS__/pull.log</string>
  <key>StandardErrorPath</key><string>__LOGS__/pull.log</string>
</dict>
</plist>
