{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run size)",
      "Bash(npm run lint)",
      "Bash(npm run check)"
    ],
    "deny": [
      "Bash(rm)",
      "Bash(rm *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)",
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler deploy *)",
      "Bash(wrangler deploy)",
      "Bash(wrangler deploy *)",
      "Bash(web/go-live.sh)",
      "Bash(web/go-live.sh *)",
      "Bash(bash web/go-live.sh)",
      "Bash(bash web/go-live.sh *)",
      "Bash(./web/go-live.sh)",
      "Bash(./web/go-live.sh *)",
      "Edit(./web/go-live.sh)",
      "Write(./web/go-live.sh)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.dev.vars)",
      "mcp__Claude_Browser"
    ]
  }
}
