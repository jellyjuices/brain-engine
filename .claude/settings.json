{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run size)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Edit(./**)",
      "Write(./**)"
    ],
    "deny": [
      "Bash(rm)",
      "Bash(rm *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)",
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler deploy *)",
      "Bash(wrangler deploy)",
      "Bash(wrangler deploy *)",
      "Bash(ops/go-live.sh)",
      "Bash(ops/go-live.sh *)",
      "Bash(bash ops/go-live.sh)",
      "Bash(bash ops/go-live.sh *)",
      "Bash(./ops/go-live.sh)",
      "Bash(./ops/go-live.sh *)",
      "Edit(./ops/go-live.sh)",
      "Write(./ops/go-live.sh)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.dev.vars)",
      "mcp__Claude_Browser"
    ]
  }
}
