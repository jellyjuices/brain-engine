{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__brain__find",
      "mcp__brain__read_note",
      "mcp__brain__relations",
      "mcp__brain__todos",
      "mcp__brain__today",
      "mcp__brain__goals",
      "mcp__brain__goal",
      "mcp__brain__decision",
      "mcp__brain__unsorted",
      "mcp__brain__log",
      "mcp__brain__intake_next",
      "Bash(brain check)",
      "Bash(brain index)",
      "Bash(brain help)",
      "Bash(brain intake *)",
      "Bash(brain thread *)"
    ],
    "deny": [
      "Edit(./sources/**)",
      "Write(./sources/**)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Bash(rm)",
      "Bash(rm *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)",
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler deploy *)",
      "Bash(wrangler deploy)",
      "Bash(wrangler deploy *)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.dev.vars)",
      "mcp__Claude_Browser"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/index-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
